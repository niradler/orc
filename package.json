{
  "name": "orc",
  "version": "0.1.56",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "release": "bun scripts/release.ts",
    "dev": "bun run --filter @orc/api dev & bun run --filter @orc/cli dev & bun run --filter @orc/web dev",
    "dev-daemon": "bun run --filter orc-ai dev-daemon:start & bun run --filter @orc/web dev",
    "build": "bun run --sequential --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome lint ./packages",
    "format": "biome format --write ./packages",
    "check": "biome check --write ./packages",
    "db:generate": "bun run --filter @orc/db generate",
    "db:push": "bun run --filter @orc/db push",
    "db:studio": "bun run --filter @orc/db studio",
    "sdk:generate": "bun run --filter @orc/sdk generate",
    "test": "bun run --filter '*' test",
    "ci": "bun scripts/ci-local.ts",
    "ci:full": "bun scripts/ci-local.ts --e2e",
    "prepare": "git config core.hooksPath .githooks || true",
    "clean": "bun run --filter '*' clean"
  },
  "overrides": {
    "minimatch@10.2.6": "11.0.3",
    "minimatch@9.0.9": "11.0.3",
    "body-parser": "2.4.0",
    "qs": "6.16.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ip-address": "10.7.5",
    "dompurify": "3.4.17",
    "js-yaml": "4.3.2",
    "nanoid@3.3.3": "3.3.20",
    "nanoid@4.0.2": "5.1.16",
    "lodash-es": "4.18.1",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.9",
    "katex": "0.18.2",
    "postcss-selector-parser@6": "6.1.5"
  },
  "devDependencies": {
    "bun": "1.4.4",
    "@biomejs/biome": "^2.6.3",
    "@orc/db": "workspace:*",
    "bun-types": "^1.4.4",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "trustedDependencies": [
    "bun",
    "electron"
  ],
  "patchedDependencies": {
    "braces@3.0.3": "patches/braces@3.0.3.patch",
    "ghostty-web@0.4.0": "patches/ghostty-web@0.4.0.patch"
  },
  "packageManager": "bun@1.4.4"
}
