{
  "name": "orc",
  "version": "0.1.33",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "release": "bun scripts/release.ts",
    "dev": "bun run --filter @orc/api dev & bun run --filter @orc/cli dev & bun run --filter @orc/web dev",
    "dev-daemon": "bun run --filter orc-ai dev-daemon:start & bun run --filter @orc/web dev",
    "build": "bun run --sequential --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome lint ./packages",
    "format": "biome format --write ./packages",
    "check": "biome check --write ./packages",
    "db:generate": "bun run --filter @orc/db generate",
    "db:push": "bun run --filter @orc/db push",
    "db:studio": "bun run --filter @orc/db studio",
    "sdk:generate": "bun run --filter @orc/sdk generate",
    "test": "bun run --filter '*' test",
    "clean": "bun run --filter '*' clean"
  },
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@modelcontextprotocol/sdk": "1.32.1",
    "simple-git": "4.0.2",
    "ip-address": "10.7.3",
    "js-yaml": "4.3.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "bun-types": "^1.3.14",
    "typescript": "^6.0.3"
  },
  "trustedDependencies": [
    "bun",
    "electron"
  ],
  "patchedDependencies": {
    "braces@3.0.3": "patches/braces@3.0.3.patch"
  }
}
