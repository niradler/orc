{
  "name": "@orc/db",
  "version": "0.1.33",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./client": "./src/client.ts",
    "./retrieval": "./src/retrieval.ts",
    "./passages": "./src/passages.ts",
    "./evidence-sync": "./src/evidence-sync.ts",
    "./wiki": "./src/wiki.ts",
    "./session-contributions": "./src/session-contributions.ts",
    "./skill-evolution": "./src/skill-evolution.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "generate": "drizzle-kit generate",
    "push": "drizzle-kit push",
    "studio": "drizzle-kit studio",
    "migrate": "bun run src/migrate.ts",
    "test": "bun test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@orc/core": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
}
