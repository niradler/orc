{
  "name": "@orc/db",
  "version": "0.1.37",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./client": "./src/client.ts",
    "./rules": "./src/rules.ts",
    "./audit": "./src/audit.ts",
    "./kb": "./src/kb.ts",
    "./kb-digest": "./src/kb-digest.ts",
    "./memories": "./src/memories.ts",
    "./skill-history": "./src/skill-history.ts",
    "./read-usage": "./src/read-usage.ts",
    "./agent-memory": "./src/agent-memory.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "generate": "drizzle-kit generate",
    "push": "drizzle-kit push",
    "studio": "drizzle-kit studio",
    "migrate": "bun run src/migrate.ts",
    "test": "bun test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@orc/core": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
