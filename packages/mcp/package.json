{
  "name": "@orc/mcp",
  "version": "0.1.70",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./meta-tools": "./src/meta-tools.ts",
    "./server": "./src/server.ts",
    "./tools": "./src/tools.ts"
  },
  "scripts": {
    "dev": "bun --env-file ../../.env --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts src/code-worker.ts --outdir dist --target bun --define ORC_NPM_BUNDLE:true",
    "test": "bun test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@orc/core": "workspace:*",
    "@orc/db": "workspace:*",
    "@orc/knowledge": "workspace:*",
    "@orc/runner": "workspace:*",
    "@orc/task-service": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "quickjs-emscripten-core": "^0.32.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@orc/channels": "workspace:*",
    "@orc/api": "workspace:*"
  }
}
