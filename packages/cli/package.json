{
  "name": "orc-ai",
  "version": "0.1.72",
  "description": "Human + AI Orchestration Hub - persistent memory, task management, session continuity and multi-agent collaboration for Cursor, Claude Code, and Codex",
  "type": "module",
  "bin": {
    "orc": "dist/index.js"
  },
  "scripts": {
    "dev": "bun --env-file ../../.env --watch src/index.ts",
    "dev-daemon:start": "bun --env-file ../../.env --watch src/index.ts daemon start",
    "daemon:stop": "bun --env-file ../../.env src/index.ts daemon stop",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "build:web": "cd ../web && bun run build",
    "build:copy-web": "bun run copy-web.ts",
    "build:opencode-plugin": "bun run build-opencode-plugin.ts",
    "build": "bun run build:web && bun run build:opencode-plugin && bun build src/index.ts --outdir dist --target bun --minify --define ORC_NPM_BUNDLE:true --external '@anthropic-ai/claude-agent-sdk' --external sqlite-vec && bun build ../mcp/src/code-worker.ts --outdir dist --target bun --minify && bun run build:copy-web && bun run copy-skills.ts",
    "build:bin": "bun run build.ts",
    "validate:package": "bun run scripts/validate-package.ts",
    "prepublishOnly": "cp ../../README.md . && bun run build && bun run validate:package",
    "test": "bun test",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist/index.js",
    "dist/code-worker.js",
    "dist/emscripten-module-*.wasm",
    "dist/checksums.txt",
    "dist/web",
    "dist/skills",
    "dist/opencode-plugin",
    "README.md"
  ],
  "devDependencies": {
    "@orc/agent-runtime": "workspace:*",
    "@orc/api": "workspace:*",
    "@orc/core": "workspace:*",
    "@orc/db": "workspace:*",
    "@orc/knowledge": "workspace:*",
    "@orc/mcp": "workspace:*",
    "@orc/runner": "workspace:*",
    "@orc/sdk": "workspace:*",
    "@orc/web": "workspace:*",
    "commander": "^15.0.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.311",
    "sqlite-vec": "0.1.9",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "bun": ">=1.4.4"
  },
  "peerDependenciesMeta": {
    "bun": {
      "optional": false
    }
  },
  "keywords": [
    "ai",
    "agent",
    "orchestration",
    "mcp",
    "claude",
    "cursor",
    "codex",
    "memory",
    "tasks",
    "hitl",
    "sessions"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niradler/orc.git"
  },
  "homepage": "https://github.com/niradler/orc",
  "bugs": {
    "url": "https://github.com/niradler/orc/issues"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "optionalDependencies": {
    "acpx": "^0.21.1",
    "skills": "1.7.4"
  }
}
