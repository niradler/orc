{
  "name": "@orc/web",
  "version": "0.1.25",
  "type": "module",
  "scripts": {
    "dev": "bun --env-file ../../.env vite",
    "build": "bun --env-file ../../.env run tsc -b && bun --env-file ../../.env vite build",
    "preview": "bun --env-file ../../.env vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "bun test tests/unit && bun run scripts/run-e2e.ts",
    "test:e2e": "bun run scripts/run-e2e.ts",
    "test:e2e:ui": "bun run scripts/run-e2e.ts --ui",
    "test:e2e:real-agent": "bun run scripts/run-real-agent-demo.ts",
    "clean": "rm -rf dist",
    "test:unit": "bun test tests/unit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@orc/sdk": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@orc/core": "workspace:*",
    "@playwright/test": "^1.62.0",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19",
    "vite": "^6.4.3"
  }
}
