    "fflate": "0.8.3",
    "ghostty-web": "^0.4.0",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.0",
    "yaml": "2.9.1"
