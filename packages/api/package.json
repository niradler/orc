{
  "name": "@orc/api",
  "version": "0.1.50",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    "./lifecycle": "./src/lifecycle.ts",
    ".": "./src/index.ts",
    "./server": "./src/server.ts"
  },
  "scripts": {
    "dev": "bun --env-file ../../.env --hot src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.5.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@orc/agent-runtime": "workspace:*",
    "@orc/core": "workspace:*",
    "@orc/db": "workspace:*",
    "@orc/gateway": "workspace:*",
    "@orc/knowledge": "workspace:*",
    "@orc/mcp": "workspace:*",
    "@orc/runner": "workspace:*",
    "@orc/task-service": "workspace:*",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.13",
    "web-push": "3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@orc/sdk": "workspace:*",
    "@types/web-push": "^3.6.4"
  }
}
