{
  "_comment": "Continuity is selected from the Rules catalog. Use the same ORC database/API configuration as the host, or install the native adapter with orc rules install-hook. Native payloads supply session identity; qualify host hook support before use.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "orc rules hook claude SessionStart",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "orc rules hook claude PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "orc rules hook claude PreCompact",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "orc rules hook claude SessionEnd",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "orc rules hook claude PermissionRequest",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "orc rules hook claude Notification",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          { "type": "command", "command": "orc rules hook claude PreToolUse", "timeout": 10 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "orc rules hook claude PostToolUseFailure",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          { "type": "command", "command": "orc rules hook claude PermissionDenied", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "orc rules hook claude UserPromptSubmit", "timeout": 10 }
        ]
      }
    ],
    "ElicitationResult": [
      {
        "hooks": [
          { "type": "command", "command": "orc rules hook claude ElicitationResult", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "orc rules hook claude Stop",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "env": {
    "ORC_API_BASE": "http://127.0.0.1:7700",
    "ORC_PROJECT": "",
    "ORC_RULES_ENABLED": "true"
  }
}
