{
  // Knip finds unused files, dependencies and exports. Run `bun run knip` for the
  // full audit; CI runs the dependency-hygiene subset via `bun run knip:deps`.
  // Entries below cover files knip cannot discover from package.json alone
  // (spawned scripts, external hooks, bundler/electron entries, generated assets).
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // `reg` is the Windows registry CLI (reg.exe), a system binary, not an npm package.
  "ignoreBinaries": ["reg"],

  "ignoreIssues": {
    // Generated by `bun run sdk:generate` (openapi-typescript); not hand-maintained.
    "packages/sdk/src/openapi.gen.ts": ["exports", "types", "duplicates"]
  },

  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts",
        "docs/.vitepress/config.ts",
        "docs/.vitepress/theme/index.ts"
      ]
    },

    "packages/api": {
      "entry": [
        "scripts/*.ts",
        // Spawned as a subprocess by path in src/__tests__/integrations.test.ts.
        "src/__tests__/fixtures/*.ts"
      ]
    },

    "packages/cli": {
      "entry": [
        // src/index.ts, build.ts, copy-web.ts and copy-skills.ts are already
        // discovered from package.json scripts; only the compiled-binary entry
        // and the build-time scripts need explicit entries.
        "src/bin-entry.ts",
        "scripts/*.ts"
      ],
      "ignoreDependencies": [
        // Intentionally external to the CLI bundle and required at runtime; enforced
        // by scripts/validate-package.ts (EXTERNAL_RUNTIME_DEPS). Do not remove.
        "@anthropic-ai/claude-agent-sdk",
        "sqlite-vec",
        "zod",
        // Build-order dependency: build.ts runs `bun run --filter @orc/web build`
        // and copy-web.ts copies packages/web/dist. Not imported as a module.
        "@orc/web"
      ]
    },

    "packages/db": {
      "entry": [
        // Spawned as a subprocess by path in src/github-sync.test.ts.
        "src/__fixtures__/*.ts"
      ]
    },

    "packages/desktop": {
      "entry": [
        // build.ts is discovered from package.json scripts; the electron main and
        // preload bundles are not, so list them explicitly.
        "src/main.ts",
        "src/preload.ts",
        "src/preview-guest-preload.ts",
        "scripts/*.ts"
      ]
    },

    "packages/pi": {
      "entry": [
        // Loaded by the pi coding agent at runtime, not imported by src.
        "extensions/*.ts"
      ]
    },

    "packages/task-service": {
      "entry": [
        // No `test` script in package.json, so knip does not auto-include these.
        "src/__tests__/*.test.ts"
      ]
    },

    "packages/web": {
      "entry": [
        "index.html",
        "public/sw.js",
        "playwright.mobile.config.ts",
        "scripts/*.ts",
        "tests/e2e/**/*.ts",
        "tests/fixtures/*.ts"
      ],
      "ignoreUnresolved": [
        // Repo-root-relative paths passed to spawn("bun", [...]) in e2e specs; knip's
        // shell visitor reads them as imports but they are subprocess targets, not modules.
        "packages/cli/src/index.ts",
        "packages/web/tests/fixtures/attention-server.ts"
      ]
    }
  }
}
